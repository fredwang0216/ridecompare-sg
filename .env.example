# Server-side only. Never put these values in index.html.
# Set these in Vercel/another serverless host environment variables.
RIDECOMPARE_PROVIDER_API_URL=
RIDECOMPARE_PROVIDER_API_KEY=

# Optional provider adapter settings.
# GET is the default. Use POST for JSON-body providers.
RIDECOMPARE_PROVIDER_METHOD=GET
# Authorization is the default. For an X-API-Key provider, use:
# RIDECOMPARE_PROVIDER_AUTH_HEADER=X-API-Key
# RIDECOMPARE_PROVIDER_AUTH_SCHEME=
RIDECOMPARE_PROVIDER_AUTH_HEADER=Authorization
RIDECOMPARE_PROVIDER_AUTH_SCHEME=Bearer
